.game-root { flex-grow: 1; width: 100%; height: 100%; background-color: rgb(35, 43, 47); -unity-font-definition: url("Malgun.ttf"); }
.tutorial-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.tutorial-shade { position: absolute; background-color: rgba(0, 0, 0, 0.84); }
.tutorial-highlight { position: absolute; border-width: 3px; border-color: rgb(255, 210, 66); border-radius: 8px; }
.tutorial-panel { position: absolute; padding: 12px; background-color: rgb(15, 22, 29); border-width: 1px; border-color: rgb(99, 119, 138); border-radius: 9px; }
.tutorial-title { font-size: 18px; -unity-font-style: bold; color: rgb(255, 249, 229); white-space: normal; margin-bottom: 6px; }
.tutorial-body { font-size: 13px; color: rgb(219, 228, 237); white-space: normal; }
.tutorial-next { height: 32px; margin-top: 10px; background-color: rgb(255, 210, 66); color: rgb(20, 27, 32); font-size: 13px; -unity-font-style: bold; border-width: 0; border-radius: 5px; transition-property: background-color, scale; transition-duration: 0.16s; transition-timing-function: ease-out; }
.tutorial-next:hover { background-color: rgb(255, 225, 126); scale: 1.025 1.025; }
.tutorial-next:active { scale: 0.97 0.97; }
.background-image-placeholder { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(0, 0, 0); }
.game-content { position: absolute; left: 0; right: 0; top: 0; bottom: 0; scale: 0.72 0.72; }
.assignment-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.hud-panel { position: absolute; top: 10px; width: 180px; height: 80px; background-color: rgb(9, 14, 17); border-width: 2px; border-color: rgb(62, 70, 75); border-radius: 8px; padding-left: 16px; padding-top: 9px; }
.grade-panel { left: 10px; }
.timer-panel { right: 10px; }
.hud-caption { font-size: 12px; color: rgb(151, 174, 196); margin: 0; padding: 0; }
.grade-row { flex-direction: row; align-items: center; height: 43px; }
.grade-value { color: rgb(255, 210, 66); font-size: 38px; -unity-font-style: bold; margin: 0; padding: 0; }
.grade-arrow { color: rgb(140, 163, 181); font-size: 17px; margin-left: 12px; margin-right: 6px; }
.next-grade { color: rgb(204, 216, 226); font-size: 15px; -unity-font-style: bold; }
.timer-value { color: rgb(255, 255, 255); font-size: 32px; -unity-font-style: bold; margin: 0; padding: 0; }
.assignment-card { position: absolute; width: 80px; height: 80px; margin: 0; padding: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0); background-image: url("project://database/Assets/05.sprite/card_task.png"); -unity-background-scale-mode: stretch-to-fill; border-width: 0; border-radius: 0; transition-duration: 0.12s; }
.assignment-card:hover { -unity-background-image-tint-color: rgb(230, 230, 230); scale: 1.04 1.04; }
.assignment-card:active { scale: 0.96 0.96; }
/* 카드 도트 1칸 = 2.5px: 카드(32)·아이콘(32)·HP바(20x2)를 같은 배율로 맞춘다. */
.assignment-icon { position: absolute; left: 0; top: -2.5px; width: 80px; height: 80px; }
.paper { width: 25px; height: 32px; background-color: rgb(247, 241, 225); padding-top: 6px; padding-left: 4px; margin-bottom: 1px; }
.paper-line { width: 16px; height: 2px; background-color: rgb(155, 147, 135); margin-bottom: 4px; }
.paper-line.short { width: 11px; }
.card-progress { height: 100%; width: 100%; flex-shrink: 0; align-self: flex-start; background-image: url("project://database/Assets/05.sprite/hp_fill_32.png"); -unity-background-scale-mode: stretch-to-fill; }
.golden { -unity-background-image-tint-color: rgb(255, 215, 90); }
.golden:hover { -unity-background-image-tint-color: rgb(255, 235, 140); }
.golden .card-progress { background-image: none; background-color: rgb(255, 215, 74); }
.result-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.72); }
.result-panel { width: 300px; padding: 28px; align-items: center; background-color: rgb(9, 14, 17); border-width: 2px; border-color: rgb(62, 70, 75); border-radius: 10px; }
.result-title { font-size: 26px; color: rgb(244, 239, 226); -unity-font-style: bold; }
.result-grade { font-size: 20px; color: rgb(255, 210, 66); margin-top: 12px; margin-bottom: 22px; }
.restart-button { height: 42px; width: 190px; font-size: 17px; -unity-font-style: bold; background-color: rgb(255, 210, 66); color: rgb(25, 30, 33); border-width: 0; border-radius: 5px; }

.score-value { position: absolute; left: 50%; translate: -50% 0; top: 10px; padding: 10px 18px; background-color: rgb(9, 14, 17); border-width: 2px; border-color: rgb(62, 70, 75); border-radius: 8px; color: rgb(255, 210, 66); font-size: 16px; -unity-font-style: bold; }
.add-points-button { position: absolute; right: 12px; bottom: 58px; height: 38px; padding-left: 14px; padding-right: 14px; background-color: rgb(39, 91, 66); border-width: 1px; border-color: rgb(92, 177, 126); border-radius: 5px; color: rgb(231, 255, 236); font-size: 13px; -unity-font-style: bold; }
.add-points-button:hover { background-color: rgb(51, 119, 84); }
.add-points-button:active { scale: 0.96 0.96; }
.unlock-all-button { bottom: 104px; }

.hp-background { position: absolute; left: 15px; top: 65px; width: 50px; height: 5px; background-color: rgb(26, 22, 19); overflow: hidden; align-items: flex-start; }

.assignment-card:active { border-color: rgb(255, 255, 255); }
.timer-value.timer-warning { color: rgb(255, 85, 91); }
.combo-popup { position: absolute; color: rgb(231, 190, 255); font-size: 20px; -unity-font-style: bold; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(35, 12, 45); }
.fever-outline { position: absolute; left: 5px; right: 5px; top: 5px; bottom: 5px; border-width: 5px; border-color: rgba(255, 44, 102, 0); }
.fever-inner-outline { position: absolute; left: 13px; right: 13px; top: 13px; bottom: 13px; border-width: 2px; border-color: rgba(255, 148, 44, 0); }
.game-root.fever-active .fever-outline { border-color: rgba(255, 42, 112, 0.92); }
.game-root.fever-active .fever-inner-outline { border-color: rgba(255, 155, 54, 0.85); }
.fever-banner { position: absolute; left: 50%; translate: -50% 0; top: 112px; padding: 7px 18px; background-color: rgba(104, 15, 86, 0.94); border-width: 2px; border-color: rgb(255, 82, 204); border-radius: 6px; color: rgb(255, 238, 249); font-size: 18px; -unity-font-style: bold; }
.game-root.fever-active .fever-banner { background-color: rgb(141, 18, 103); }
.assignment-card.fever-hit { -unity-background-image-tint-color: rgb(255, 110, 220); scale: 1.1 1.1; }
.assignment-card.robot-hit { -unity-background-image-tint-color: rgb(100, 240, 236); scale: 1.06 1.06; }
.robot-hit-ring { position: absolute; width: 28px; height: 28px; border-width: 3px; border-color: rgb(82, 255, 247); border-radius: 50%; opacity: 0.9; transition-duration: 0.18s; }

.skill-button { height: 42px; width: 190px; margin-top: 10px; font-size: 17px; -unity-font-style: bold; background-color: rgb(40, 52, 60); color: rgb(244, 239, 226); border-width: 2px; border-color: rgb(100, 120, 135); border-radius: 5px; }
.skill-button:hover { background-color: rgb(52, 68, 78); }

.reset-progress-button { position: absolute; right: 12px; bottom: 12px; height: 38px; padding-left: 14px; padding-right: 14px; font-size: 14px; -unity-font-style: bold; background-color: rgb(47, 35, 38); color: rgb(235, 190, 190); border-width: 1px; border-color: rgb(126, 75, 80); border-radius: 5px; }
.reset-progress-button:hover { background-color: rgb(75, 42, 46); color: rgb(255, 224, 224); }
.reset-progress-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.72); }
.reset-progress-panel { width: 360px; padding: 24px; align-items: center; background-color: rgb(9, 14, 17); border-width: 2px; border-color: rgb(126, 75, 80); border-radius: 10px; }
.reset-progress-title { font-size: 21px; -unity-font-style: bold; color: rgb(255, 224, 224); -unity-text-align: middle-center; }
.reset-progress-message { margin-top: 10px; margin-bottom: 20px; font-size: 14px; color: rgb(204, 216, 226); -unity-text-align: middle-center; white-space: normal; }
.reset-progress-actions { flex-direction: row; justify-content: center; }
.reset-progress-cancel, .reset-progress-confirm { height: 38px; width: 110px; font-size: 15px; -unity-font-style: bold; border-radius: 5px; }
.reset-progress-cancel { margin-right: 8px; background-color: rgb(40, 52, 60); color: rgb(244, 239, 226); border-width: 1px; border-color: rgb(100, 120, 135); }
.reset-progress-confirm { margin-left: 8px; background-color: rgb(156, 47, 54); color: rgb(255, 244, 244); border-width: 0; }
.reset-progress-confirm:hover { background-color: rgb(190, 54, 63); }

.skill-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgb(18, 21, 24); }
.skill-viewport { position: absolute; left: 0; right: 0; top: 0; bottom: 0; overflow: hidden; }
.skill-canvas { position: absolute; left: 50%; top: 50%; width: 0; height: 0; }
.skill-title { position: absolute; top: 18px; left: 0; right: 0; -unity-text-align: upper-center; font-size: 26px; -unity-font-style: bold; color: rgb(244, 239, 226); }
.skill-points-panel { position: absolute; top: 10px; left: 10px; width: 180px; height: 64px; padding: 8px 16px; background-color: rgb(9, 14, 17); border-width: 2px; border-color: rgb(210, 214, 218); border-radius: 8px; }
.skill-points-value { color: rgb(255, 210, 66); font-size: 26px; -unity-font-style: bold; margin: 0; padding: 0; }
.skill-close-button { position: absolute; top: 10px; right: 10px; width: 90px; height: 42px; font-size: 16px; -unity-font-style: bold; background-color: rgb(40, 52, 60); color: rgb(244, 239, 226); border-width: 2px; border-color: rgb(100, 120, 135); border-radius: 6px; }
.skill-close-button:hover { background-color: rgb(52, 68, 78); }

.skill-node { position: absolute; margin: 0; padding: 2px 3px; align-items: center; justify-content: center; background-color: rgb(26, 30, 34); border-width: 3px; border-radius: 5px; transition-duration: 0.1s; }
.skill-node:hover { scale: 1.06 1.06; }
.skill-node.locked { opacity: 0.38; }
.skill-node.affordable { border-width: 4px; }
.skill-node-name { font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; color: rgb(244, 239, 226); margin: 0; padding: 0; }
.skill-node-cost { font-size: 11px; color: rgb(255, 210, 66); margin: 0; padding: 0; }
.skill-node.owned .skill-node-cost { color: rgb(190, 200, 208); }

.skill-detail { position: absolute; bottom: 14px; left: 50%; translate: -50% 0; width: 480px; padding: 14px 18px; align-items: center; background-color: rgb(9, 14, 17); border-width: 2px; border-color: rgb(62, 70, 75); border-radius: 10px; }
.skill-detail-name { font-size: 20px; -unity-font-style: bold; color: rgb(244, 239, 226); }
.skill-detail-effect { font-size: 14px; color: rgb(204, 216, 226); white-space: normal; -unity-text-align: upper-center; margin-top: 4px; }
.skill-detail-state { font-size: 12px; color: rgb(151, 174, 196); margin-top: 6px; }
.skill-buy-button { height: 38px; width: 170px; margin-top: 8px; font-size: 16px; -unity-font-style: bold; background-color: rgb(255, 210, 66); color: rgb(25, 30, 33); border-width: 0; border-radius: 5px; }
.skill-buy-button:disabled { background-color: rgb(70, 76, 82); color: rgb(150, 156, 162); }

.skill-legend { position: absolute; left: 10px; top: 84px; padding: 8px 12px; background-color: rgba(9, 14, 17, 0.8); border-radius: 8px; }
.skill-legend-row { flex-direction: row; align-items: center; margin-bottom: 4px; }
.skill-legend-swatch { width: 12px; height: 12px; border-radius: 2px; margin-right: 8px; }
.skill-legend-text { font-size: 13px; color: rgb(204, 216, 226); margin: 0; padding: 0; }
.skill-legend-hint { font-size: 11px; color: rgb(120, 140, 155); margin-top: 6px; }
.assignment-card.golden,
.assignment-card.golden:hover,
.assignment-card.golden:active,
.assignment-card.golden.fever-hit,
.assignment-card.golden.robot-hit { border-color: rgb(255, 221, 45); }
.assignment-card.bug { background-color: rgb(82, 25, 30); border-color: rgb(225, 48, 59); }
.assignment-card.bug:hover { background-color: rgb(112, 30, 38); border-color: rgb(255, 83, 91); }
.assignment-card.bug .card-progress { background-color: rgb(238, 58, 67); }
.assignment-card.sleep { background-color: rgb(0, 0, 0); border-color: rgb(105, 105, 105); }
.assignment-card.drinking-party:hover,
.assignment-card.sleep:hover { background-color: rgb(28, 28, 28); border-color: rgb(170, 170, 170); }
.assignment-card.drinking-party .card-progress,
.assignment-card.sleep .card-progress { background-color: rgb(238, 58, 67); }


.full-reset-button { position: absolute; left: 12px; bottom: 12px; height: 38px; padding-left: 14px; padding-right: 14px; font-size: 14px; background-color: rgb(100, 32, 38); color: rgb(255, 224, 224); border-width: 1px; border-color: rgb(190, 75, 80); border-radius: 5px; }
.full-reset-button:hover { background-color: rgb(145, 42, 50); }
