<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="SkillTree.uss" />
    <ui:VisualElement name="skill-tree-overlay" class="tree-overlay" focusable="true">
        <ui:VisualElement class="tree-toolbar"><ui:Label text="스킬 트리"/><ui:Label name="tree-points" text="0 P"/><ui:Button name="tree-close" text="닫기 ×"/></ui:VisualElement>
        <!-- 노드와 연결선은 SkillTreeUI가 SkillTable의 좌표로 만든다. -->
        <ui:VisualElement name="tree-viewport" class="tree-viewport"><ui:VisualElement name="skill-tree-board" class="tree-board"/></ui:VisualElement>
        <ui:VisualElement name="skill-description" class="tree-popup" style="display: none; left: 350px; top: 250px;">
            <ui:Label name="tree-detail-title" text="클릭 피해" class="tree-popup-title"/><ui:Label name="tree-detail-effect" text="클릭 피해 +1" class="tree-popup-description"/><ui:Label name="tree-detail-requirement" text="선행: 입학(S0)" class="tree-popup-requirement"/><ui:Button name="tree-buy" text="50 P 구매" class="tree-popup-price"/>
        </ui:VisualElement></ui:VisualElement></ui:UXML>
