/* Pixel ring skill tree: 05.sprite/01_tree_ui frames tinted per sector, thin connections. */
.tree-overlay { -unity-font-definition: url("Malgun.ttf"); position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(29, 29, 30); }
.tree-toolbar { position: absolute; left: 24px; right: 24px; top: 14px; height: 38px; flex-direction: row; align-items: center; justify-content: space-between; color: rgb(231, 230, 223); font-size: 18px; -unity-font-style: bold; }
.tree-toolbar Button { width: 90px; height: 32px; border-radius: 0; border-width: 1px; border-color: rgb(105, 105, 104); background-color: rgb(29, 29, 30); color: rgb(220, 220, 214); font-size: 14px; }
.tree-viewport { position: absolute; left: 24px; right: 24px; top: 64px; bottom: 16px; overflow: hidden; }
.tree-board { position: absolute; left: 0; top: 0; width: 1020px; height: 780px; }
.tree-line { position: absolute; }
.tree-popup { position: absolute; width: 320px; padding: 4px; background-color: rgb(10, 10, 11); border-width: 3px; border-color: rgb(3, 3, 4); }
.tree-popup-title { font-size: 19px; -unity-font-style: bold; padding: 7px; margin: 0; border-bottom-width: 2px; border-bottom-color: rgb(106, 106, 102); }
.tree-popup-description { font-size: 15px; color: rgb(230, 230, 222); white-space: normal; -unity-text-align: middle-center; margin: 0; padding: 10px 8px; }
.tree-popup-requirement { font-size: 12px; color: rgb(188, 188, 182); white-space: normal; -unity-text-align: middle-center; border-top-width: 2px; border-top-color: rgb(106, 106, 102); margin: 0; padding: 7px 4px; }
.tree-popup-price { font-size: 14px; color: rgb(245, 212, 112); background-color: rgb(78, 37, 40); -unity-text-align: middle-center; margin: 0; padding: 7px 3px; }
.tree-popup-price { border-radius: 0; border-width: 1px; border-color: rgb(125,65,65); }
.tree-popup-price:hover { background-color: rgb(105,48,50); }
.tree-popup-price:active { background-color: rgb(130,60,62); }
.tree-popup-price:disabled { background-color: rgb(48, 48, 49); color: rgb(155, 155, 150); }

/* 노드: 프레임 0 = 보이지만 못 삼, 1 = 살 수 있음, 2 = 구매함. 색은 SkillTreeUI가 섹터별로 칠한다. */
.tree-node { position: absolute; margin: 0; padding: 0; translate: -50% -50%; border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: stretch-to-fill; align-items: center; justify-content: center; }
/* 소수 배율로 커지면 도트가 깨지므로 hover는 크기 대신 밝기로 */
.tree-node:hover { opacity: 0.85; }
.tree-node:active { translate: -50% -48%; }
/* 크기는 전부 스프라이트 원본 × 3 (스탯 18, 핵심·교차 20, 최종·시작 24, 졸업 32, 아이콘 16) */
.tree-icon { width: 48px; height: 48px; flex-shrink: 0; -unity-background-scale-mode: stretch-to-fill; }
.node-start { width: 72px; height: 72px; background-image: url("project://database/Assets/05.sprite/01_tree_ui/node_start.png"); }
.node-stat { width: 54px; height: 54px; background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/node_stat_0.png"); }
.node-stat.affordable { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/node_stat_1.png"); }
.node-stat.owned { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/node_stat_2.png"); }
.node-core { width: 60px; height: 60px; background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/node_core_0.png"); }
.node-core.affordable { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/node_core_1.png"); }
.node-core.owned { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/node_core_2.png"); }
.node-cross { width: 60px; height: 60px; background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/node_cross_0.png"); }
.node-cross.affordable { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/node_cross_1.png"); }
.node-cross.owned { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/node_cross_2.png"); }
.node-final { width: 72px; height: 72px; background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/node_sector_final_0.png"); }
.node-final.affordable { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/node_sector_final_1.png"); }
.node-final.owned { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/node_sector_final_2.png"); }
.shine-a .node-final.owned { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/node_sector_final_shine_0.png"); }
.shine-b .node-final.owned { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/node_sector_final_shine_1.png"); }
.node-graduation { width: 96px; height: 96px; background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/node_graduation_0.png"); }
.node-graduation.affordable { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/node_graduation_1.png"); }
.node-graduation.owned { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/node_graduation_2.png"); }
.shine-a .node-graduation.owned { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/node_graduation_shine_0.png"); }
.shine-b .node-graduation.owned { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/node_graduation_shine_1.png"); }
/* 졸업 프로젝트 아이콘(32px)을 학사모 아래 화면 칸에 */
.node-graduation .tree-icon { translate: 0 15px; }

/* 살 수 있는 노드의 고리(20px × 3) */
.tree-pulse { position: absolute; left: 50%; top: 50%; width: 60px; height: 60px; translate: -50% -50%; display: none; -unity-background-scale-mode: stretch-to-fill; background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/highlight_pulse_0.png"); }
.tree-node.affordable .tree-pulse { display: flex; }
.pulse-1 .tree-node.affordable .tree-pulse { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/highlight_pulse_1.png"); }
.pulse-2 .tree-node.affordable .tree-pulse { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/highlight_pulse_2.png"); }

/* 링 잠금 학점 (링 4 = C, 5 = B, 6 = A, 7+ = A+). 조건을 채우면 숨긴다. */
.grade-badge { position: absolute; right: -6px; top: -6px; width: 30px; height: 27px; -unity-background-scale-mode: stretch-to-fill; }
.grade-badge.badge-4 { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/grade_badge_0.png"); }
.grade-badge.badge-6 { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/grade_badge_1.png"); }
.grade-badge.badge-8 { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/grade_badge_2.png"); }
.grade-badge.badge-9 { background-image: url("project://database/Assets/05.sprite/01_tree_ui/frames/grade_badge_3.png"); }
.tree-node.grade-met .grade-badge, .tree-node.hidden .grade-badge { display: none; }
.tree-node.hidden { opacity: 0.45; }

.rebirth-node, .rebirth-origin { position: absolute; translate: -50% -50%; width: 130px; height: 76px; border-radius: 38px; border-width: 2px; border-color: rgb(230, 145, 215); background-color: rgb(70, 40, 67); color: rgb(250, 225, 246); -unity-text-align: middle-center; white-space: normal; font-size: 15px; }
.rebirth-origin { width: 64px; height: 64px; background-color: rgb(10, 10, 12); }
.rebirth-node.owned { background-color: rgb(115, 60, 105); }
.rebirth-node.affordable { border-width: 4px; }
.rebirth-node:hover { background-color: rgb(145, 75, 130); }
